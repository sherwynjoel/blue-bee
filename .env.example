# ───────── Blue Bee — environment template ─────────
# Copy to .env and fill in. NEVER commit real values. Grouped by service (PRD §8, §11.2).

# Core
NODE_ENV=development
API_PORT=3000
WEB_PORT=3001
API_BASE_URL=http://localhost:3000

# Postgres (PostGIS + TimescaleDB) — see infra/docker-compose.yml
DATABASE_URL=postgresql://bluebee:bluebee@localhost:5432/bluebee

# Redis (live location store, cache, BullMQ queues)
REDIS_URL=redis://localhost:6379

# Auth / JWT (PRD §8.1) — secrets MUST be >= 32 chars of entropy (enforced at boot); prod rejects placeholders
JWT_ACCESS_SECRET=change-me-to-a-32+char-random-secret
JWT_REFRESH_SECRET=change-me-to-a-32+char-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Phone-OTP auth (PRD §8.1, §12.1) — pepper MUST be >= 32 chars
OTP_PEPPER=change-me-to-a-32+char-random-pepper
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_RATE_PER_PHONE=5
OTP_RATE_PER_IP=20
OTP_RATE_WINDOW_SECONDS=3600
# SMS transport selector: 'console' (dev — logs the code) or 'twilio' (real send via TWILIO_* below)
SMS_TRANSPORT=console
TWILIO_FROM_NUMBER=

# Maps / routing / ETA (PRD §6) — Google Maps Platform (primary)
GOOGLE_MAPS_API_KEY=
# Mapbox (alternative)
MAPBOX_ACCESS_TOKEN=

# Payments — Stripe (PRD §8.4)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# SMS / WhatsApp — Twilio (PRD §8.5)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Email — SendGrid (or AWS SES)
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@bluebee.example

# Push — Expo Push (FCM/APNs)
EXPO_ACCESS_TOKEN=

# Object storage — AWS S3 (intake/before/after photos, POD, signatures)
AWS_REGION=ca-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=bluebee-media
# Allow-list of origins the photo endpoints accept object references from (Increment 3).
# Until presigned uploads land (storage increment), photos register references to objects
# already hosted on these origins; the configured S3 bucket origin is always allowed.
MEDIA_ALLOWED_ORIGINS=https://bluebee-media.s3.ca-central-1.amazonaws.com
# MEDIA_CDN_ORIGIN=https://cdn.bluebee.example

# Tax — Ontario HST fallback when an Organization has no billing_config.taxRate (Increment 3).
TAX_RATE_HST=0.13

# Realtime managed swap-in (optional; Socket.IO self-hosted by default)
ABLY_API_KEY=
PUSHER_APP_ID=

# Accounting sync (PRD §8.4)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Realtime tracking channel (Increment 6) ──
# Dedicated secret for the short-lived customer WS tracking token (NOT the auth JWT). >=32 chars.
CHANNEL_TOKEN_SECRET=change-me-to-a-32+char-random-secret
# TTL (seconds) for the minted channel token; the active-stop state is the real bound.
CHANNEL_TOKEN_TTL_SECONDS=600

# ── Notifications (Increment 8) ── matrix-driven engine + outbox; transports behind a seam.
# Email — SendGrid (SENDGRID_API_KEY above). Sandbox = validate + 2xx, NO delivery (default on).
SENDGRID_SANDBOX=true
SENDGRID_FROM_EMAIL=no-reply@bluebee.example
SENDGRID_FROM_NAME=Blue Bee
# Push transport selector: 'console' (real local impl, dev) or 'expo' (real Expo Push API).
PUSH_TRANSPORT=console
# (SMS reuses the Increment-2 Twilio seam — set SMS_TRANSPORT=twilio + TWILIO_* above for real sends.)
# Engine tunables (no magic literals):
NOTIF_MAX_ATTEMPTS=3
NOTIF_RETRY_BACKOFF_MS=60000
NOTIF_SEND_TIMEOUT_MS=8000
# Background drain scan (ms) for retry/deferred rows; 0 = disabled. Prod: e.g. 2000–5000.
NOTIF_RETRY_SCAN_MS=0
# Fire a one-off background drain on enqueue so alerts send promptly off the ingest thread.
NOTIF_KICK_ON_DISPATCH=true
# Quiet-hours policy for NON-urgent events inside a recipient's window: 'defer' or 'suppress'.
NOTIF_QUIET_HOURS_POLICY=defer
NOTIF_DEFAULT_TIMEZONE=America/Toronto
# CSV of event types that BYPASS quiet hours (time-critical). Default: both geofence alerts.
NOTIF_URGENT_EVENT_TYPES=geofence.approaching,geofence.arrived
# Per-event channel matrix override (CSV of PUSH,SMS,EMAIL); defaults to PUSH,SMS,EMAIL.
# NOTIF_MATRIX_GEOFENCE_APPROACHING=PUSH,SMS,EMAIL
# NOTIF_MATRIX_GEOFENCE_ARRIVED=PUSH,SMS,EMAIL
