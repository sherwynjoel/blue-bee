# ───────── Blue Bee — environment template ─────────
# Copy to .env and fill in. NEVER commit real values. Grouped by service (PRD §8, §11.2).

# Core
NODE_ENV=development
API_PORT=3000
WEB_PORT=3001
API_BASE_URL=http://localhost:3000

# Postgres (PostGIS + TimescaleDB) — see infra/docker-compose.yml
DATABASE_URL=postgresql://bluebee:bluebee@localhost:5432/bluebee

# Redis (live location store, cache, BullMQ queues)
REDIS_URL=redis://localhost:6379

# Auth / JWT (PRD §8.1)
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Maps / routing / ETA (PRD §6) — Google Maps Platform (primary)
GOOGLE_MAPS_API_KEY=
# Mapbox (alternative)
MAPBOX_ACCESS_TOKEN=

# Payments — Stripe (PRD §8.4)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# SMS / WhatsApp — Twilio (PRD §8.5)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Email — SendGrid (or AWS SES)
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@bluebee.example

# Push — Expo Push (FCM/APNs)
EXPO_ACCESS_TOKEN=

# Object storage — AWS S3 (intake/before/after photos, POD, signatures)
AWS_REGION=ca-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=bluebee-media

# Realtime managed swap-in (optional; Socket.IO self-hosted by default)
ABLY_API_KEY=
PUSHER_APP_ID=

# Accounting sync (PRD §8.4)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
