# Dependencies
node_modules/
.pnp
.pnp.*

# Build output
dist/
build/
.next/
out/
.expo/
.expo-shared/
.turbo/
*.tsbuildinfo

# Environment / secrets — NEVER commit real keys. Ignore every .env* (incl. .env.production /
# .env.staging) and keep ONLY the tracked template (Increment 14b — match the .dockerignore + the docs).
.env
.env.*
!.env.example
*.pem
google-service-account*.json
serviceAccountKey*.json

# Native build artifacts
ios/Pods/
ios/build/
android/.gradle/
android/app/build/
*.keystore

# Generated native projects. The three Expo apps are managed (continuous native generation): no
# android/ or ios/ is committed, and `expo run:android` / `expo prebuild` regenerates them from
# app.json on demand. Without these, a single local `expo run:android` drops several hundred
# untracked files into the tree.
apps/*/android/
apps/*/ios/
*.jks

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Test / coverage
coverage/
.nyc_output/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json

# exFAT/Windows external-drive artifacts
$RECYCLE.BIN/
System Volume Information/
LOST.DIR/

# founder design renders (reference only, not app assets)
blue-bee-reference-customer/

# subagent-driven-development scratch workspace (ledgers, briefs, review packages — not build output)
.superpowers/
