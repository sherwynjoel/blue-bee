// Blue Bee — Prisma schema (Phase-1 specialty slice).
// Models & fields follow PRD §9; enums mirror @blue-bee/shared (single source of
// truth) and the §5 state machines EXACTLY. Phase-2 entities (linen/resident/
// production/contracts/cost-centers/manifests) are intentionally NOT modeled here
// (PRD §14.1 cut line). `Service` is the one catalog model included beyond the
// owner's slice list because OrderLine requires it for a real specialty order.
//
// Conventions:
//  • Every row carries: id (uuid), org_id, created_at, updated_at, created_by (PRD §9).
//  • org_id is a scalar scoping column (no FK) present on EVERY table, including
//    Organization (where it equals its own id) — enables RBAC row-scoping (§8.1).
//  • PostGIS geography(Point,4326) columns use Prisma `Unsupported(...)` (queried
//    via raw SQL). The CREATE EXTENSION, GpsPing hypertable, and the append-only
//    triggers for CustodyEvent + AuditLog are injected into the migration SQL.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, timescaledb]
}

// ─────────────────────────────── enums (mirror @blue-bee/shared) ───────────────────────────────

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum RoleType {
  OWNER
  DISPATCHER
  CSR
  PLANT_OP
  DRIVER
  FINANCE
  ACCOUNT_ADMIN
  ACCOUNT_STAFF
  RESIDENTIAL_CUSTOMER
}

enum RoleScope {
  ORG
  ACCOUNT
  SITE
}

enum AccountType {
  RESIDENTIAL
  BUSINESS
}

enum ServiceVertical {
  SPECIALTY
  LINEN
  WASHFOLD
}

enum ServiceUnit {
  SQFT
  PIECE
  LB
  ITEM
}

enum OrderVertical {
  SPECIALTY
  LINEN
  WASHFOLD
}

enum OrderType {
  JOB
  ROUTE_STOP_ORDER
}

// PRD §5.1 — specialty job lifecycle (NORMATIVE).
enum OrderStatus {
  REQUESTED
  SCHEDULED_PICKUP
  PICKUP_EN_ROUTE
  PICKED_UP
  INTAKE_INSPECTED
  QUOTED
  QUOTE_APPROVED
  QUOTE_DECLINED
  IN_CLEANING
  QC
  READY
  SCHEDULED_DELIVERY
  DELIVERY_EN_ROUTE
  DELIVERED
  INVOICED
  CLOSED
  CLOSED_NO_WORK
  DAMAGE_PREEXISTING_FLAGGED
  ON_HOLD
  REWASH
  CLAIM_OPENED
  CLAIM_RESOLVED
}

enum ItemKind {
  RUG
  CARPET
  BLIND
  UPHOLSTERY
  GARMENT
  LINEN
}

enum ItemStatus {
  RECEIVED
  INSPECTED
  IN_CLEANING
  QC
  READY
  DELIVERED
}

enum TagType {
  QR
  BARCODE
  RFID
}

enum TagBinding {
  ITEM
  CART
  CONTAINER
  RESIDENT
}

enum PhotoKind {
  INTAKE
  BEFORE
  AFTER
  POD
  CLAIM
}

enum MediaUploadStatus {
  PENDING
  CONFIRMED
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  DECLINED
  EXPIRED
}

enum CustodyStage {
  PICKED_UP
  INTAKE
  INSPECTED
  DUSTING
  WASH
  DRY
  FINISH
  QC
  READY
  OUT_FOR_DELIVERY
  DELIVERED
}

// Track-B (care homes) — the resident personal-clothing lifecycle (PRD §5.2-B, lines ~187-193). Values
// map the PRD states EXACTLY (no invented states); used both as the garment's denormalized current
// status (Item.garmentStatus) and as the append-only custody checkpoint (CustodyEvent.garmentStage).
enum GarmentStatus {
  GARMENT_ENROLLED
  SOIL_PICKUP
  INTAKE_SORT
  WASH
  RETURN_SORT
  DELIVERED_TO_RESIDENT
  LOST_FOUND_POOL
  RECONCILE
}

enum ResidentStatus {
  ACTIVE
  DISCHARGED
}

enum LostFoundStatus {
  OPEN
  RECONCILED
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum ShiftStatus {
  SCHEDULED
  ACTIVE
  ENDED
}

enum RouteStatus {
  PLANNED
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RouteStopKind {
  PICKUP
  DELIVERY
  BOTH
}

// Track-A (condo B2B) — concierge/lobby handoff. ORTHOGONAL to RouteStopKind (which is the
// pickup/delivery operation): `stopKind` marks WHERE the handoff happens — a single building
// concierge/lobby point (CONCIERGE) vs an individual unit/address (DIRECT). Default DIRECT keeps
// every existing Phase-1 stop unchanged.
enum RouteStopHandoff {
  DIRECT
  CONCIERGE
}

// PRD §5.4 — RouteStop lifecycle (NORMATIVE).
enum RouteStopStatus {
  PENDING
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  FAILED
  SKIPPED
}

enum GeofenceEventType {
  APPROACHING
  ARRIVED
  DEPARTED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  VOID
}

// Track-A (condo B2B) — per-account billing terms (PRD §9.1 Account.billing_terms).
// PER_ORDER = one invoice per order (the Inc-12 specialty default). BATCH_PERIODIC = one
// periodic invoice batching all billable orders in a period (the B2B building-account path,
// net-days from `billing_net_days`). Cost-center split billing stays deferred (Phase 2).
enum BillingMode {
  PER_ORDER
  BATCH_PERIODIC
}

// Track-A (condo B2B) — standing-order cadence (RRULE-lite). WEEKLY/BIWEEKLY anchored on a
// weekday; biweekly parity is measured in whole days from `starts_on` (DST-safe — see
// recurring-schedule.ts). Full RRULE + par/soil/pack-to-par stay deferred (Phase 2).
enum StandingOrderCadence {
  WEEKLY
  BIWEEKLY
}

// [Track A Phase 2] CostCenter.kind — condo/B2B billing-group taxonomy (PRD §B4.1). Nullable on the row.
enum CostCenterKind {
  WING
  FLOOR
  FUNDING
  AMENITY
  OTHER
}

enum PaymentMethod {
  CARD
  APPLE_PAY
  GOOGLE_PAY
  ACH
  PAD
  CASH
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// [DERIVED] Refund.status (Increment 12). Mirrors Stripe refund status.
enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

// [DERIVED] Dispute.status (Increment 12). We RECORD + surface (we do not adjudicate); maps from
// Stripe charge.dispute lifecycle (needs_response/under_review → won/lost/closed).
enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  WON
  LOST
  CLOSED
}

enum ClaimType {
  DAMAGE
  LOSS
  SERVICE
}

enum ClaimStatus {
  OPEN
  APPROVED
  DENIED
  RESOLVED
}

enum CommsChannel {
  PUSH
  SMS
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  RETRYING // (Increment 8) a transport attempt failed; a bounded retry is scheduled (scheduled_for)
  SENT
  DELIVERED
  FAILED
  SUPPRESSED // (Increment 8) deliberately not sent — a user opt-out or (config) a quiet-hours suppression
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

// ─────────────────────────────── identity & accounts (§9.1) ───────────────────────────────

model Organization {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid // self-reference (== id)
  name          String
  settings      Json     @default("{}")
  billingConfig Json     @default("{}") @map("billing_config")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdBy     String?  @map("created_by") @db.Uuid

  @@index([orgId])
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  orgId         String     @map("org_id") @db.Uuid
  name          String
  email         String?
  phone         String?
  authProviders String[]   @default([]) @map("auth_providers")
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  createdBy     String?    @map("created_by") @db.Uuid

  roles            UserRole[]
  driver           Driver?
  devices          Device[]
  deviceTokens     DeviceToken[]
  notifications    Notification[]
  notificationPref NotificationPreference?
  messagesFrom     Message[]               @relation("MessageFrom")
  messagesTo       Message[]               @relation("MessageTo")
  auditLogs        AuditLog[]
  refreshTokens    RefreshToken[]

  @@unique([orgId, email])
  @@index([orgId])
}

model UserRole {
  id        String    @id @default(uuid()) @db.Uuid
  orgId     String    @map("org_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  role      RoleType
  scope     RoleScope @default(ORG)
  scopeId   String?   @map("scope_id") @db.Uuid // account_id or site_id when scope != ORG
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role, scope, scopeId])
  @@index([orgId])
  @@index([userId])
}

model Account {
  id             String      @id @default(uuid()) @db.Uuid
  orgId          String      @map("org_id") @db.Uuid
  type           AccountType
  name           String
  billingTerms   Json        @default("{}") @map("billing_terms")
  // Track-A (condo B2B) — per-account billing terms. `billingMode` selects the invoicing path
  // (PER_ORDER specialty default vs BATCH_PERIODIC building-account batching); `billingNetDays`
  // is the net-terms due window for a periodic invoice. The free-form `billingTerms` JSON stays for
  // any extra config. Cost-center split billing remains deferred (Phase 2).
  billingMode    BillingMode @default(PER_ORDER) @map("billing_mode")
  billingNetDays Int         @default(0) @map("billing_net_days")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  createdBy      String?     @map("created_by") @db.Uuid

  sites          Site[]
  orders         Order[]
  invoices       Invoice[]
  routeStops     RouteStop[]
  priceLists     PriceList[]
  standingOrders StandingOrder[]
  costCenters    CostCenter[]

  @@index([orgId])
}

model Site {
  id             String                                 @id @default(uuid()) @db.Uuid
  orgId          String                                 @map("org_id") @db.Uuid
  accountId      String                                 @map("account_id") @db.Uuid
  name           String
  address        String?
  // PostGIS geography(Point,4326); set/queried via raw SQL (ST_MakePoint/ST_AsText).
  geo            Unsupported("geography(Point, 4326)")?
  serviceWindows Json                                   @default("[]") @map("service_windows")
  createdAt      DateTime                               @default(now()) @map("created_at")
  updatedAt      DateTime                               @updatedAt @map("updated_at")
  createdBy      String?                                @map("created_by") @db.Uuid

  account        Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  orders         Order[]
  routeStops     RouteStop[]
  standingOrders StandingOrder[]
  residents      Resident[]
  lostFoundItems LostFoundItem[]
  costCenters    CostCenter[]

  @@index([orgId])
  @@index([accountId])
}

// ─────────────────────────────── catalog (§9.2 — specialty only this phase) ───────────────────────────────

model Service {
  id        String          @id @default(uuid()) @db.Uuid
  orgId     String          @map("org_id") @db.Uuid
  vertical  ServiceVertical @default(SPECIALTY)
  name      String
  unit      ServiceUnit
  baseRate  Decimal         @map("base_rate") @db.Decimal(12, 4)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  createdBy String?         @map("created_by") @db.Uuid

  orderLines     OrderLine[]
  priceListItems PriceListItem[]
  standingOrders StandingOrder[]

  @@index([orgId])
}

// PRD §9.2 — PriceList / PriceListItem (catalog pricing with per-account overrides).
// Added in Increment 3: the quote engine resolves a rate as
//   per-account override → org default price-list rate → Service.base_rate.
// A PriceList with account_id = NULL is the org default; one bound to an account
// is that account's rate card. (Increment-1 modeled only `Service`; this closes the
// §9.2 catalog gap the quote engine needs — additive, no change to existing rows.)
model PriceList {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String
  accountId String?  @map("account_id") @db.Uuid // NULL = org default; set = account-specific rate card
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid

  account Account?        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  items   PriceListItem[]

  @@index([orgId])
  @@index([accountId])
}

model PriceListItem {
  id              String   @id @default(uuid()) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  priceListId     String   @map("price_list_id") @db.Uuid
  serviceId       String   @map("service_id") @db.Uuid
  rate            Decimal  @db.Decimal(12, 4)
  // Optional per-account override rate (PRD §9.2 `account_override?`). When set on an
  // account-bound price list it supersedes `rate` for that account; resolution order:
  // account_override → account list rate → org-default list rate → Service.base_rate.
  accountOverride Decimal? @map("account_override") @db.Decimal(12, 4)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdBy       String?  @map("created_by") @db.Uuid

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  service   Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([priceListId, serviceId])
  @@index([orgId])
  @@index([serviceId])
}

// ─────────────────────────────── orders, items & custody (§9.3) ───────────────────────────────

model Order {
  id                      String        @id @default(uuid()) @db.Uuid
  orgId                   String        @map("org_id") @db.Uuid
  accountId               String        @map("account_id") @db.Uuid
  siteId                  String?       @map("site_id") @db.Uuid
  vertical                OrderVertical @default(SPECIALTY)
  type                    OrderType     @default(JOB)
  status                  OrderStatus   @default(REQUESTED)
  // When an order goes ON_HOLD, the state it was paused in is recorded here so a
  // resume returns to it (or a legal successor) per §5.1 "any → ON_HOLD → resumes".
  // Cleared on resume. (Increment 3 — needed by canTransitionOrder's heldFrom arg.)
  heldFrom                OrderStatus?  @map("held_from")
  scheduledPickupWindow   Json?         @map("scheduled_pickup_window")
  scheduledDeliveryWindow Json?         @map("scheduled_delivery_window")
  totals                  Json          @default("{}")
  // [Track A Phase 2] Cost-centre split-billing attribution — orthogonal metadata (never touches the
  // §5.1 spine). The batch-invoice engine groups by this id; FK SET NULL ⇒ a deleted centre falls the
  // order into the "Unassigned" bucket (never lost).
  costCenterId            String?       @map("cost_center_id") @db.Uuid
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")
  createdBy               String?       @map("created_by") @db.Uuid

  account    Account     @relation(fields: [accountId], references: [id])
  site       Site?       @relation(fields: [siteId], references: [id])
  costCenter CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  lines      OrderLine[]
  items      Item[]
  quotes     Quote[]
  photos     Photo[]
  routeStops RouteStop[]
  payments   Payment[]
  claims     Claim[]
  messages   Message[]

  @@index([orgId])
  @@index([accountId])
  @@index([status])
  // Track-A: the batch-invoicing path filters an account's orders by a created-at window
  // (account_id + created_at range), so a composite index keeps that query index-only.
  @@index([accountId, createdAt])
  @@index([costCenterId])
}

model OrderLine {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  serviceId String?  @map("service_id") @db.Uuid
  // The specialty item this line prices (one line per item). Nullable for ad-hoc
  // charges with no physical item. (Increment 3 — links §9.3 Item ↔ OrderLine so the
  // quote engine can pull measured values per item; PRD §9.7 hangs both off Order.)
  itemId    String?  @map("item_id") @db.Uuid
  qty       Int      @default(1)
  measure   Float?
  rate      Decimal  @db.Decimal(12, 4)
  amount    Decimal  @db.Decimal(12, 2)
  // Per-line upcharges applied on top of measure × rate (PRD §8.3 "+ upcharges").
  // Array of { code, label, amount }. Empty for a plain line. amount above is inclusive.
  upcharges Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id])
  item    Item?    @relation(fields: [itemId], references: [id])

  @@index([orgId])
  @@index([orderId])
  @@index([itemId])
}

model Item {
  id            String         @id @default(uuid()) @db.Uuid
  orgId         String         @map("org_id") @db.Uuid
  // Track-B (care homes): a resident's personal garment is owned by the RESIDENT, not an order, so
  // order_id is now optional. Existing specialty items always carry an order; garments carry a
  // residentId instead (and join an order only if/when they go through a specialty cycle).
  orderId       String?        @map("order_id") @db.Uuid
  // Track-B: the care-home resident who owns this garment (Item.kind = GARMENT). PRD §9.3 resident_id?.
  residentId    String?        @map("resident_id") @db.Uuid
  tagId         String?        @unique @map("tag_id") @db.Uuid
  kind          ItemKind
  status        ItemStatus     @default(RECEIVED)
  // Track-B: the resident-garment lifecycle position (§5.2-B). Null for non-garment items.
  garmentStatus GarmentStatus? @map("garment_status")
  measurements  Json           @default("{}")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  createdBy     String?        @map("created_by") @db.Uuid

  order          Order?          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  resident       Resident?       @relation(fields: [residentId], references: [id])
  tag            Tag?            @relation(fields: [tagId], references: [id])
  inspections    Inspection[]
  photos         Photo[]
  custodyEvents  CustodyEvent[]
  claims         Claim[]
  orderLines     OrderLine[]
  lostFoundItems LostFoundItem[]

  @@index([orgId])
  @@index([orderId])
  @@index([residentId])
}

// Track-B (care homes) — a resident is the OWNER of personal garments (PRD §9 line ~413). PII is
// sensitive (§12.2): least-privilege + every READ audited. Cost-center linkage (wing/floor/funding
// line) stays DEFERRED — no CostCenter model in this slice (modeled-for, not faked).
model Resident {
  id        String         @id @default(uuid()) @db.Uuid
  orgId     String         @map("org_id") @db.Uuid
  siteId    String         @map("site_id") @db.Uuid
  name      String
  room      String?
  status    ResidentStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  createdBy String?        @map("created_by") @db.Uuid

  site           Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  garments       Item[]
  lostFoundItems LostFoundItem[]

  @@index([orgId])
  @@index([siteId])
}

// Track-B (care homes) — an unmatched/odd garment dropped into the site's lost & found pool on return
// sort (PRD §9 line ~425 / §5.2-B / B3.3). `reconcile` assigns a pooled item to a resident.
model LostFoundItem {
  id                  String          @id @default(uuid()) @db.Uuid
  orgId               String          @map("org_id") @db.Uuid
  siteId              String          @map("site_id") @db.Uuid // found_at_site
  tagId               String?         @map("tag_id") @db.Uuid
  itemId              String?         @map("item_id") @db.Uuid // the pooled garment Item
  candidateResidentId String?         @map("candidate_resident_id") @db.Uuid
  status              LostFoundStatus @default(OPEN)
  notes               String?
  reconciledAt        DateTime?       @map("reconciled_at")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  createdBy           String?         @map("created_by") @db.Uuid

  site              Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  item              Item?     @relation(fields: [itemId], references: [id])
  candidateResident Resident? @relation(fields: [candidateResidentId], references: [id])

  @@index([orgId])
  @@index([siteId])
  @@index([status])
}

model Tag {
  id        String     @id @default(uuid()) @db.Uuid
  orgId     String     @map("org_id") @db.Uuid
  code      String
  type      TagType    @default(QR)
  boundTo   TagBinding @default(ITEM) @map("bound_to")
  active    Boolean    @default(true)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  createdBy String?    @map("created_by") @db.Uuid

  item Item?

  @@unique([orgId, code])
  @@index([orgId])
}

model Inspection {
  id                String    @id @default(uuid()) @db.Uuid
  orgId             String    @map("org_id") @db.Uuid
  itemId            String    @map("item_id") @db.Uuid
  conditionCodes    String[]  @default([]) @map("condition_codes")
  notes             String?
  preexistingDamage Boolean   @default(false) @map("preexisting_damage")
  ackBy             String?   @map("ack_by") @db.Uuid
  ackAt             DateTime? @map("ack_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  createdBy         String?   @map("created_by") @db.Uuid

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([itemId])
}

model Photo {
  id          String                                 @id @default(uuid()) @db.Uuid
  orgId       String                                 @map("org_id") @db.Uuid
  itemId      String?                                @map("item_id") @db.Uuid
  orderId     String?                                @map("order_id") @db.Uuid
  podId       String?                                @map("pod_id") @db.Uuid
  claimId     String?                                @map("claim_id") @db.Uuid
  kind        PhotoKind
  // Increment 10: real uploaded objects store an org-namespaced object KEY (signed GET minted on
  // read). `url` is now nullable — retained only for the legacy external-reference fallback.
  storageKey  String?                                @unique @map("storage_key")
  contentType String?                                @map("content_type")
  sizeBytes   Int?                                   @map("size_bytes")
  url         String?
  geo         Unsupported("geography(Point, 4326)")?
  takenAt     DateTime                               @default(now()) @map("taken_at")
  createdAt   DateTime                               @default(now()) @map("created_at")
  updatedAt   DateTime                               @updatedAt @map("updated_at")
  createdBy   String?                                @map("created_by") @db.Uuid

  item  Item?            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  order Order?           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pod   ProofOfDelivery? @relation(fields: [podId], references: [id], onDelete: Cascade)
  claim Claim?           @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([itemId])
  @@index([orderId])
}

// Presigned-upload intent (Increment 10). A /media/presign records WHO is uploading WHAT to WHICH
// target + the declared content-type/size; /media/confirm verifies the object (HEAD) against this
// intent and creates the Photo. So "the caller presigned this key" is provable, and PENDING rows
// whose object never landed are the orphan-reconciliation set. Org-scoped; key is globally unique.
model MediaUpload {
  id          String            @id @default(uuid()) @db.Uuid
  orgId       String            @map("org_id") @db.Uuid
  storageKey  String            @unique @map("storage_key")
  kind        PhotoKind
  contentType String            @map("content_type")
  byteSize    Int               @map("byte_size")
  orderId     String?           @map("order_id") @db.Uuid
  itemId      String?           @map("item_id") @db.Uuid
  status      MediaUploadStatus @default(PENDING)
  photoId     String?           @map("photo_id") @db.Uuid
  createdBy   String            @map("created_by") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([orgId])
  @@index([status])
}

model Quote {
  id          String      @id @default(uuid()) @db.Uuid
  orgId       String      @map("org_id") @db.Uuid
  orderId     String      @map("order_id") @db.Uuid
  lines       Json        @default("[]")
  subtotal    Decimal     @db.Decimal(12, 2)
  tax         Decimal     @db.Decimal(12, 2)
  total       Decimal     @db.Decimal(12, 2)
  // Audit trail of manual adjustments (PRD §8.3 "audit of manual adjustments").
  // Array of { reason, actorId, before, after, at }. Also mirrored to AuditLog.
  adjustments Json        @default("[]")
  status      QuoteStatus @default(DRAFT)
  expiresAt   DateTime?   @map("expires_at")
  approvedBy  String?     @map("approved_by") @db.Uuid
  approvedAt  DateTime?   @map("approved_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  createdBy   String?     @map("created_by") @db.Uuid

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([orderId])
}

// Append-only (PRD §8.2/§8.6) — a DB trigger blocks UPDATE/DELETE (injected in migration SQL).
model CustodyEvent {
  id           String                                 @id @default(uuid()) @db.Uuid
  orgId        String                                 @map("org_id") @db.Uuid
  itemId       String?                                @map("item_id") @db.Uuid // cart custody is Phase 2
  // Specialty cleaning checkpoint (null for a resident-garment event, which uses garmentStage instead).
  stage        CustodyStage?
  // Track-B: the resident-garment lifecycle checkpoint (§5.2-B). Null for a specialty custody event.
  garmentStage GarmentStatus?                         @map("garment_stage")
  actorId      String?                                @map("actor_id") @db.Uuid
  geo          Unsupported("geography(Point, 4326)")?
  deviceId     String?                                @map("device_id")
  occurredAt   DateTime                               @default(now()) @map("occurred_at")
  createdAt    DateTime                               @default(now()) @map("created_at")
  updatedAt    DateTime                               @updatedAt @map("updated_at")
  createdBy    String?                                @map("created_by") @db.Uuid

  item Item? @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([itemId])
  @@index([occurredAt])
}

// ─────────────────────────────── logistics & tracking (§9.5) ───────────────────────────────

model Vehicle {
  id        String        @id @default(uuid()) @db.Uuid
  orgId     String        @map("org_id") @db.Uuid
  label     String
  capacity  Int?
  plate     String?
  status    VehicleStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  createdBy String?       @map("created_by") @db.Uuid

  shifts            Shift[]
  routes            Route[]
  gpsPings          GpsPing[]
  defaultForDrivers Driver[]

  @@index([orgId])
}

model Driver {
  id               String   @id @default(uuid()) @db.Uuid
  orgId            String   @map("org_id") @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  license          String?
  defaultVehicleId String?  @map("default_vehicle_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdBy        String?  @map("created_by") @db.Uuid

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultVehicle Vehicle? @relation(fields: [defaultVehicleId], references: [id])
  shifts         Shift[]
  routes         Route[]

  @@index([orgId])
}

model Shift {
  id        String      @id @default(uuid()) @db.Uuid
  orgId     String      @map("org_id") @db.Uuid
  driverId  String      @map("driver_id") @db.Uuid
  vehicleId String      @map("vehicle_id") @db.Uuid
  startedAt DateTime?   @map("started_at")
  endedAt   DateTime?   @map("ended_at")
  status    ShiftStatus @default(SCHEDULED)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  createdBy String?     @map("created_by") @db.Uuid

  driver   Driver    @relation(fields: [driverId], references: [id])
  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id])
  gpsPings GpsPing[]

  @@index([orgId])
  @@index([driverId])
}

model Route {
  id        String                                 @id @default(uuid()) @db.Uuid
  orgId     String                                 @map("org_id") @db.Uuid
  date      DateTime                               @db.Date
  driverId  String?                                @map("driver_id") @db.Uuid
  vehicleId String?                                @map("vehicle_id") @db.Uuid
  status    RouteStatus                            @default(PLANNED)
  optimized Boolean                                @default(false)
  // Depot/start point for the in-house sequencer (PostGIS distance origin). Set via raw
  // SQL (Unsupported geography). Increment 4 — additive; null ⇒ sequence from the first stop.
  startGeo  Unsupported("geography(Point, 4326)")? @map("start_geo")
  createdAt DateTime                               @default(now()) @map("created_at")
  updatedAt DateTime                               @updatedAt @map("updated_at")
  createdBy String?                                @map("created_by") @db.Uuid

  driver    Driver?     @relation(fields: [driverId], references: [id])
  vehicle   Vehicle?    @relation(fields: [vehicleId], references: [id])
  stops     RouteStop[]
  manifests Manifest[]

  @@index([orgId])
  @@index([date])
}

model RouteStop {
  id              String           @id @default(uuid()) @db.Uuid
  orgId           String           @map("org_id") @db.Uuid
  routeId         String           @map("route_id") @db.Uuid
  seq             Int
  accountId       String?          @map("account_id") @db.Uuid
  siteId          String?          @map("site_id") @db.Uuid
  orderId         String?          @map("order_id") @db.Uuid
  kind            RouteStopKind    @default(PICKUP)
  // Track-A (condo B2B) — concierge/lobby handoff flag (orthogonal to `kind`). CONCIERGE = a single
  // building-handoff point (lobby/concierge) vs DIRECT = an individual unit/address. Additive;
  // every Phase-1 stop stays DIRECT.
  stopKind        RouteStopHandoff @default(DIRECT) @map("stop_kind")
  timeWindow      Json?            @map("time_window")
  status          RouteStopStatus  @default(PENDING)
  // Reason code recorded when a stop is FAILED or SKIPPED (PRD §5.4/§6.3 exceptions).
  // Required by the API on those transitions. Increment 4 — additive, nullable.
  exceptionReason String?          @map("exception_reason")
  // Server-side ETA (Increment 7, PRD §6.2) — computed in-house behind the EtaEstimator seam,
  // smoothed (EWMA) and surfaced as a RANGE. `eta` is the smoothed point ("mid") arrival; eta_low
  // / eta_high bound the surfaced range; eta_computed_at is the freshness stamp (and the EWMA
  // memory — the next recompute ages the prior `eta` by the elapsed time). All additive/nullable.
  eta             DateTime?
  etaLow          DateTime?        @map("eta_low")
  etaHigh         DateTime?        @map("eta_high")
  etaComputedAt   DateTime?        @map("eta_computed_at")
  arrivedAt       DateTime?        @map("arrived_at")
  completedAt     DateTime?        @map("completed_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  createdBy       String?          @map("created_by") @db.Uuid

  route          Route            @relation(fields: [routeId], references: [id], onDelete: Cascade)
  account        Account?         @relation(fields: [accountId], references: [id])
  site           Site?            @relation(fields: [siteId], references: [id])
  order          Order?           @relation(fields: [orderId], references: [id])
  geofenceEvents GeofenceEvent[]
  pod            ProofOfDelivery?
  manifests      Manifest[]

  @@unique([routeId, seq])
  @@index([orgId])
  @@index([routeId])
}

// Time-series (PostGIS/Timescale). Converted to a hypertable on `recorded_at`
// via raw SQL in the migration. Composite PK [id, recorded_at] so the unique
// index includes the partitioning column (Timescale requirement).
model GpsPing {
  id         String                                 @default(uuid()) @db.Uuid
  orgId      String                                 @map("org_id") @db.Uuid
  shiftId    String                                 @map("shift_id") @db.Uuid
  vehicleId  String                                 @map("vehicle_id") @db.Uuid
  geo        Unsupported("geography(Point, 4326)")?
  speed      Float?
  heading    Float?
  recordedAt DateTime                               @map("recorded_at")
  createdAt  DateTime                               @default(now()) @map("created_at")
  updatedAt  DateTime                               @updatedAt @map("updated_at")
  createdBy  String?                                @map("created_by") @db.Uuid

  shift   Shift   @relation(fields: [shiftId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@id([id, recordedAt])
  // Dedup key (Increment 5): a vehicle has at most one ping per recorded_at instant, so a
  // replayed/duplicate batch is a no-op via INSERT … ON CONFLICT DO NOTHING (§6.2 robust
  // ingestion). Includes the partition column (recorded_at), satisfying Timescale's
  // unique-index-must-cover-partition-key rule.
  @@unique([vehicleId, recordedAt])
  @@index([orgId])
  @@index([shiftId])
  @@index([vehicleId])
  @@index([recordedAt])
}

model GeofenceEvent {
  id          String            @id @default(uuid()) @db.Uuid
  orgId       String            @map("org_id") @db.Uuid
  routeStopId String            @map("route_stop_id") @db.Uuid
  type        GeofenceEventType
  occurredAt  DateTime          @default(now()) @map("occurred_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  createdBy   String?           @map("created_by") @db.Uuid

  routeStop RouteStop @relation(fields: [routeStopId], references: [id], onDelete: Cascade)

  // Idempotency (Increment 7, §6.4): each geofence type fires EXACTLY once per stop. The unique
  // (route_stop_id, type) + INSERT … ON CONFLICT DO NOTHING makes a re-entry after GPS/traffic
  // jitter (or a concurrent same-vehicle batch) a no-op — no duplicate rows, no alert spam.
  @@unique([routeStopId, type])
  @@index([orgId])
  @@index([routeStopId])
}

model ProofOfDelivery {
  id           String                                 @id @default(uuid()) @db.Uuid
  orgId        String                                 @map("org_id") @db.Uuid
  routeStopId  String                                 @unique @map("route_stop_id") @db.Uuid
  signatureUrl String?                                @map("signature_url")
  // Increment 10: the POD signature as a real uploaded object key (signed GET on read), parallel to
  // Photo.storageKey. Populated by the driver POD-capture flow (a later increment); column added now.
  signatureKey String?                                @map("signature_key")
  capturedBy   String?                                @map("captured_by") @db.Uuid
  geo          Unsupported("geography(Point, 4326)")?
  capturedAt   DateTime                               @default(now()) @map("captured_at")
  createdAt    DateTime                               @default(now()) @map("created_at")
  updatedAt    DateTime                               @updatedAt @map("updated_at")
  createdBy    String?                                @map("created_by") @db.Uuid

  routeStop RouteStop @relation(fields: [routeStopId], references: [id], onDelete: Cascade)
  photos    Photo[]

  @@index([orgId])
}

// PRD §9.5 Manifest — the expected items/orders for a route or stop (load sheet / pickup
// check-list). Increment 4 added this (Increment 1 deferred it, like PriceList); Phase-1
// specialty manifests list the order's items expected at a pickup stop. `lines` is a jsonb
// snapshot generated at a point in time. Bound to a route OR a single stop.
model Manifest {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  routeId     String?  @map("route_id") @db.Uuid
  routeStopId String?  @map("route_stop_id") @db.Uuid
  lines       Json     @default("[]")
  generatedAt DateTime @default(now()) @map("generated_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String?  @map("created_by") @db.Uuid

  route     Route?     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  routeStop RouteStop? @relation(fields: [routeStopId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([routeId])
  @@index([routeStopId])
}

// ─────────────────────────────── Track-A: standing / recurring orders (condo B2B) ───────────────────────────────
// Phase-2-foundation thin slice (PRD §9.2 StandingOrder, §14 recurring route auto-generation). The
// PRD's canonical StandingOrder hangs off a Contract; Contract/ParLevel/par-soil-pack stay DEFERRED
// (Phase 2, not built/faked), so the thin slice binds a standing order directly to account+site+
// service and leaves the contract linkage modeled-for (a future nullable contract_id when Contract
// lands). A real generation job materializes due standing orders into real Orders (+ a recurring
// Route), idempotently — never fabricated rows.

model StandingOrder {
  id           String               @id @default(uuid()) @db.Uuid
  orgId        String               @map("org_id") @db.Uuid
  accountId    String               @map("account_id") @db.Uuid
  siteId       String               @map("site_id") @db.Uuid
  serviceId    String               @map("service_id") @db.Uuid
  vertical     OrderVertical        @default(SPECIALTY)
  cadence      StandingOrderCadence
  // RRULE-lite: the pickup recurs on `weekday` (0=Sun..6=Sat); BIWEEKLY also requires the
  // whole-day gap from `startsOn` to be an even number of weeks (parity computed DST-safe).
  weekday      Int
  // Local time-of-day pickup window applied to each occurrence date: { start: "HH:MM", end: "HH:MM" }.
  pickupWindow Json                 @map("pickup_window")
  // True ⇒ the generated pickup is a single building concierge/lobby handoff (RouteStop.stopKind=CONCIERGE).
  concierge    Boolean              @default(false)
  active       Boolean              @default(true)
  // [Track A Phase 2] Cost centre the generated orders inherit (split-billing attribution). SET NULL.
  costCenterId String?              @map("cost_center_id") @db.Uuid
  startsOn     DateTime             @map("starts_on") @db.Date // first eligible date + biweekly parity anchor
  endsOn       DateTime?            @map("ends_on") @db.Date
  nextRunAt    DateTime?            @map("next_run_at") // next due occurrence date (advisory; generation recomputes)
  lastRunAt    DateTime?            @map("last_run_at")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  createdBy    String?              @map("created_by") @db.Uuid

  account     Account                   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // Restrict (Prisma's default for a required relation, made explicit): a Site/Service in use by a
  // standing order can't be deleted out from under it.
  site        Site                      @relation(fields: [siteId], references: [id], onDelete: Restrict)
  service     Service                   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  costCenter  CostCenter?               @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  occurrences StandingOrderOccurrence[]

  @@index([orgId])
  @@index([accountId])
  @@index([active, nextRunAt])
  @@index([costCenterId])
}

// One row per (standing order, period) materialization — the IDEMPOTENCY ledger. `period_key` is the
// occurrence's ISO date (YYYY-MM-DD); the unique (standing_order_id, period_key) + INSERT … ON
// CONFLICT DO NOTHING (the Inc-5 pattern) makes a re-run/concurrent generation a no-op — exactly one
// Order per period. `order_id` is set in the same claim transaction; `route_id` is set when route
// auto-gen succeeds and stays NULL on a degraded run (the generated Order is never lost). order_id /
// route_id are scalars (no relation) — mirrors Invoice.order_id, keeping Order/Route untouched.
model StandingOrderOccurrence {
  id              String   @id @default(uuid()) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  standingOrderId String   @map("standing_order_id") @db.Uuid
  periodKey       String   @map("period_key")
  orderId         String?  @map("order_id") @db.Uuid
  routeId         String?  @map("route_id") @db.Uuid
  generatedAt     DateTime @default(now()) @map("generated_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdBy       String?  @map("created_by") @db.Uuid

  standingOrder StandingOrder @relation(fields: [standingOrderId], references: [id], onDelete: Cascade)

  @@unique([standingOrderId, periodKey])
  @@index([orgId])
  @@index([orderId])
  @@index([routeId])
}

// ─────────────────────────────── billing, comms & system (§9.6) ───────────────────────────────

model Invoice {
  id                  String        @id @default(uuid()) @db.Uuid
  orgId               String        @map("org_id") @db.Uuid
  accountId           String        @map("account_id") @db.Uuid
  // Increment 12: link an invoice to the order it bills (specialty one-off). Scalar (no relation) to
  // keep the Order model untouched; billing queries by this id.
  orderId             String?       @map("order_id") @db.Uuid
  period              String?
  number              String?       @unique
  lines               Json          @default("[]")
  subtotal            Decimal       @db.Decimal(12, 2)
  tax                 Decimal       @db.Decimal(12, 2)
  total               Decimal       @db.Decimal(12, 2)
  currency            String        @default("CAD")
  status              InvoiceStatus @default(DRAFT)
  // Stripe Invoices path (outbound, deferred): the id of the Stripe invoice when one is created.
  stripeInvoiceId     String?       @unique @map("stripe_invoice_id")
  issuedAt            DateTime?     @map("issued_at")
  paidAt              DateTime?     @map("paid_at")
  dueAt               DateTime?     @map("due_at")
  costCenterBreakdown Json          @default("{}") @map("cost_center_breakdown")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  createdBy           String?       @map("created_by") @db.Uuid

  account      Account       @relation(fields: [accountId], references: [id])
  payments     Payment[]
  invoiceLines InvoiceLine[]

  @@index([orgId])
  @@index([accountId])
  @@index([orderId])
}

// Per-line invoice breakdown (Increment 12) — lines from the approved quote + the HST line.
model InvoiceLine {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  invoiceId    String   @map("invoice_id") @db.Uuid
  description  String
  quantity     Int      @default(1)
  unitAmount   Decimal  @map("unit_amount") @db.Decimal(12, 2)
  amount       Decimal  @db.Decimal(12, 2)
  // [Track A Phase 2] The cost centre this line is attributed to (from the billed order). SET NULL.
  costCenterId String?  @map("cost_center_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  invoice    Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  costCenter CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([invoiceId])
  @@index([costCenterId])
}

// [Track A Phase 2 — PRD §B4.1/§A5.2/§B5.2] A cost centre = a building's billing group (wing / floor /
// funding line / amenity-vs-resident), living UNDER one Account (optionally scoped to a Site). Orders +
// standing orders are attributed to one; the batch-invoice engine groups invoiced lines by cost centre
// and writes a reconciling `Invoice.costCenterBreakdown`. Additive to the proven Account→Site model —
// NOT a parent-of-accounts entity.
model CostCenter {
  id        String          @id @default(uuid()) @db.Uuid
  orgId     String          @map("org_id") @db.Uuid
  accountId String          @map("account_id") @db.Uuid
  siteId    String?         @map("site_id") @db.Uuid
  code      String
  name      String
  kind      CostCenterKind?
  active    Boolean         @default(true)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  createdBy String?         @map("created_by") @db.Uuid

  account        Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  site           Site?           @relation(fields: [siteId], references: [id], onDelete: SetNull)
  orders         Order[]
  standingOrders StandingOrder[]
  invoiceLines   InvoiceLine[]

  @@unique([accountId, code])
  @@index([orgId])
  @@index([accountId])
  @@index([siteId])
}

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  orgId                 String        @map("org_id") @db.Uuid
  invoiceId             String?       @map("invoice_id") @db.Uuid
  orderId               String?       @map("order_id") @db.Uuid
  accountId             String?       @map("account_id") @db.Uuid
  method                PaymentMethod @default(CARD)
  amount                Decimal       @db.Decimal(12, 2)
  currency              String        @default("CAD")
  status                PaymentStatus @default(PENDING)
  // ── Stripe linkage (Increment 12) ── set server-side; the webhook maps events back to this row.
  stripeRef             String?       @map("stripe_ref")
  stripePaymentIntentId String?       @unique @map("stripe_payment_intent_id")
  stripeChargeId        String?       @map("stripe_charge_id")
  // Stripe idempotency key used to create the intent (so a retry never creates a second intent).
  idempotencyKey        String?       @map("idempotency_key")
  captureMethod         String        @default("automatic") @map("capture_method")
  // Denormalized money state (cents-exact via Decimal): captured-so-far + refunded-so-far drive the
  // partial-refund ceiling without re-summing children. Advanced ONLY on a webhook-confirmed event.
  capturedAmount        Decimal       @default(0) @map("captured_amount") @db.Decimal(12, 2)
  refundedAmount        Decimal       @default(0) @map("refunded_amount") @db.Decimal(12, 2)
  capturedAt            DateTime?     @map("captured_at")
  attempts              Int           @default(0)
  lastError             String?       @map("last_error")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  createdBy             String?       @map("created_by") @db.Uuid

  invoice  Invoice?  @relation(fields: [invoiceId], references: [id])
  order    Order?    @relation(fields: [orderId], references: [id])
  refunds  Refund[]
  disputes Dispute[]

  @@index([orgId])
  @@index([invoiceId])
  @@index([orderId])
}

// A refund against a captured payment (Increment 12). Driven to SUCCEEDED by charge.refunded.
model Refund {
  id             String       @id @default(uuid()) @db.Uuid
  orgId          String       @map("org_id") @db.Uuid
  paymentId      String       @map("payment_id") @db.Uuid
  orderId        String?      @map("order_id") @db.Uuid
  stripeRefundId String?      @unique @map("stripe_refund_id")
  amount         Decimal      @db.Decimal(12, 2)
  currency       String       @default("CAD")
  reason         String?
  status         RefundStatus @default(PENDING)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  createdBy      String?      @map("created_by") @db.Uuid

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([orgId])
  @@index([paymentId])
}

// A chargeback/dispute (Increment 12) — we RECORD + surface + alert; we never adjudicate.
model Dispute {
  id              String        @id @default(uuid()) @db.Uuid
  orgId           String        @map("org_id") @db.Uuid
  paymentId       String?       @map("payment_id") @db.Uuid
  orderId         String?       @map("order_id") @db.Uuid
  stripeDisputeId String        @unique @map("stripe_dispute_id")
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("CAD")
  reason          String?
  status          DisputeStatus @default(OPEN)
  evidenceDueBy   DateTime?     @map("evidence_due_by")
  openedAt        DateTime      @default(now()) @map("opened_at")
  resolvedAt      DateTime?     @map("resolved_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([orgId])
  @@index([paymentId])
}

// Webhook idempotency ledger (Increment 12) — one row per processed Stripe event id. Insert ON
// CONFLICT DO NOTHING INSIDE the handler transaction makes redelivery/concurrency a no-op (a row's
// existence == the event was fully applied). Append-only (a DB trigger blocks UPDATE/DELETE).
model ProcessedStripeEvent {
  id         String   @id @default(uuid()) @db.Uuid
  eventId    String   @unique @map("event_id")
  type       String
  orgId      String?  @map("org_id") @db.Uuid
  receivedAt DateTime @default(now()) @map("received_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([type])
}

model Claim {
  id         String      @id @default(uuid()) @db.Uuid
  orgId      String      @map("org_id") @db.Uuid
  orderId    String?     @map("order_id") @db.Uuid
  itemId     String?     @map("item_id") @db.Uuid
  type       ClaimType
  amount     Decimal?    @db.Decimal(12, 2)
  status     ClaimStatus @default(OPEN)
  approvedBy String?     @map("approved_by") @db.Uuid
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  createdBy  String?     @map("created_by") @db.Uuid

  order  Order?  @relation(fields: [orderId], references: [id])
  item   Item?   @relation(fields: [itemId], references: [id])
  photos Photo[]

  @@index([orgId])
}

model Message {
  id         String       @id @default(uuid()) @db.Uuid
  orgId      String       @map("org_id") @db.Uuid
  threadId   String       @map("thread_id") @db.Uuid
  orderId    String?      @map("order_id") @db.Uuid
  fromUserId String?      @map("from_user") @db.Uuid
  toUserId   String?      @map("to_user") @db.Uuid
  channel    CommsChannel @default(IN_APP)
  body       String
  sentAt     DateTime     @default(now()) @map("sent_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  createdBy  String?      @map("created_by") @db.Uuid

  order    Order? @relation(fields: [orderId], references: [id])
  fromUser User?  @relation("MessageFrom", fields: [fromUserId], references: [id])
  toUser   User?  @relation("MessageTo", fields: [toUserId], references: [id])

  @@index([orgId])
  @@index([threadId])
}

model Notification {
  id                String             @id @default(uuid()) @db.Uuid
  orgId             String             @map("org_id") @db.Uuid
  userId            String             @map("user_id") @db.Uuid
  eventType         String             @map("event_type")
  channel           CommsChannel
  payload           Json               @default("{}")
  status            NotificationStatus @default(PENDING)
  // ── Outbox (Increment 8, §8.5) ──
  // The source domain event this notification was raised from (e.g. a GeofenceEvent row), used to
  // build the dedup key + trace the trigger. source_id is the event-source row id.
  sourceType        String?            @map("source_type")
  sourceId          String?            @map("source_id") @db.Uuid
  // Idempotency: one row per (event source, recipient, channel). The unique dedupe_key + INSERT …
  // ON CONFLICT DO NOTHING (the Increment-5 pattern) makes a re-fired / replayed / concurrent
  // trigger append zero duplicates and send exactly once.
  dedupeKey         String             @unique @map("dedupe_key")
  urgent            Boolean            @default(false) // bypasses quiet-hours deferral (time-critical alerts)
  attempts          Int                @default(0) // transport send attempts so far (retry accounting)
  lastError         String?            @map("last_error") // the final/most-recent transport error (FAILED diagnosis)
  providerMessageId String?            @map("provider_message_id") // Twilio SID / SendGrid id / Expo ticket
  // When set, the row is held until this instant (quiet-hours deferral OR retry backoff). NULL = due now.
  scheduledFor      DateTime?          @map("scheduled_for")
  sentAt            DateTime?          @map("sent_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  createdBy         String?            @map("created_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([userId])
  // The drain scan picks up due work: PENDING/RETRYING rows whose scheduled_for has passed.
  @@index([status, scheduledFor])
}

// (Increment 8, §8.5/§11.2) Push-delivery target a client app registers for a user. The real
// registration surface the customer/driver app POSTs to (`POST /v1/device-tokens`); the Expo/FCM/APNs
// transport reads ACTIVE rows for a recipient. A row per push token, globally unique (one physical
// device = one token; on re-register the owner is reassigned via upsert). Distinct from the legacy
// `Device` session record (§9.1) — see ARCHITECTURE.md (push-registration reconciliation).
model DeviceToken {
  id         String         @id @default(uuid()) @db.Uuid
  orgId      String         @map("org_id") @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  platform   DevicePlatform
  token      String         @unique // the Expo push token (globally unique per device)
  active     Boolean        @default(true) // unregister = deactivate (kept for audit, excluded from sends)
  lastSeenAt DateTime?      @map("last_seen_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  createdBy  String?        @map("created_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([userId])
}

// (Increment 8, §8.5) Per-user notification preferences — channel opt-outs + a quiet-hours window.
// Quiet hours are stored as minutes-from-local-midnight in the user's IANA `timezone`; a window that
// wraps midnight (e.g. 22:00→07:00) is supported. Absent row ⇒ all channels on, no quiet hours.
model NotificationPreference {
  id              String   @id @default(uuid()) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  pushEnabled     Boolean  @default(true) @map("push_enabled")
  smsEnabled      Boolean  @default(true) @map("sms_enabled")
  emailEnabled    Boolean  @default(true) @map("email_enabled")
  quietHoursStart Int?     @map("quiet_hours_start") // minutes from local midnight [0,1440)
  quietHoursEnd   Int?     @map("quiet_hours_end") // minutes from local midnight [0,1440)
  timezone        String   @default("America/Toronto")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdBy       String?  @map("created_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

// Immutable (PRD §8.7/§9.6) — a DB trigger blocks UPDATE/DELETE (injected in migration SQL).
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  entity    String
  entityId  String   @map("entity_id") @db.Uuid
  action    String
  before    Json?
  after     Json?
  at        DateTime @default(now())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid

  actor User? @relation(fields: [actorId], references: [id])

  @@index([orgId])
  @@index([entity, entityId])
}

model Device {
  id        String         @id @default(uuid()) @db.Uuid
  orgId     String         @map("org_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  pushToken String?        @map("push_token")
  platform  DevicePlatform
  lastSeen  DateTime?      @map("last_seen")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  createdBy String?        @map("created_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([userId])
}

// ─────────────────────────────── auth (Increment 2 — item 4) ───────────────────────────────

// Phone-OTP challenge. Stores only a HASH of the code (never plaintext), with
// expiry + attempt accounting (PRD §8.1, §12.1). Rate-limit counters live in Redis.
model OtpChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  phone       String
  codeHash    String    @map("code_hash")
  expiresAt   DateTime  @map("expires_at")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  consumedAt  DateTime? @map("consumed_at")
  requestIp   String?   @map("request_ip")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdBy   String?   @map("created_by") @db.Uuid

  @@index([orgId])
  @@index([phone])
}

// Server-side refresh token (rotation + reuse detection + revocation, PRD §8.1/§12.1).
// Only a hash of the opaque token is stored. Tokens form a `familyId` chain; presenting
// a rotated/revoked token revokes the whole family (reuse = theft signal).
model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  familyId    String    @map("family_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  rotatedToId String?   @map("rotated_to_id") @db.Uuid
  reusedAt    DateTime? @map("reused_at")
  userAgent   String?   @map("user_agent")
  createdByIp String?   @map("created_by_ip")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdBy   String?   @map("created_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([userId])
  @@index([familyId])
}
