{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "moduleResolution": "Bundler",
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["jest", "node"],
    "paths": {
      "@blue-bee/shared": ["../../packages/shared/src/index.ts"],
      "@blue-bee/api-client": ["../../packages/api-client/src/index.ts"],
      "@blue-bee/ui": ["../../packages/ui/src/index.ts"],
      "@blue-bee/design-tokens": ["../../packages/design-tokens/src/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist", ".expo"]
}
